#!/usr/bin/env bash
set -eu -o pipefail
name=${1-$( ssh ubx.lbl.gov 'cd /tmp && sudo /opt/ITDT/itdt -f /dev/sg3 inventory' |perl -00 -nle '$n=[/([0-9]+)\s*$/ms]->[0]; $s={map {@$_[0,1]} map {[map {s/^\s+|\s+$//r} split /\s*\.\.+\s*/]} split /\n/}; $s{$n}=$s if defined($n); END{print $s{1}{"Volume Tag"}}')}
media=${2-/media/lto8}
if [[ -z $name ]]; then
  echo "Could not determine tape label name." >&2
  exit 1
fi

ssh ubx.lbl.gov 'find '"$(printf '%q' "$media")"'/ ! -type d -printf "%P\n"' |sort |gzip >"$name.list.gz.tmp.$$"
mv -v "$name.list.gz.tmp.$$" "$name.list.gz"
