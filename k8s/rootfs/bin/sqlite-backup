#!/usr/bin/env bash
set -eu -o pipefail
shopt -s nullglob
DB_PATH=${1-}
if [[ -z $DB_PATH ]]; then
  echo "Usage: $0 DB_PATH" >&2
  exit 1
fi
if [[ ! -d $DB_PATH ]]; then
  echo "Could not find db directory $DB_PATH!" >&2
  exit 1
fi
BACKUP_NAME=${BACKUP_NAME-$(basename "$DB_PATH")}
BACKUP_DIR=${BACKUP_DIR-/backup}
BACKUP_FILE="$BACKUP_DIR/${BACKUP_NAME}_$(date '+%Y-%m-%d-%H-%M-%S').tar.gz"
HOURLY=${HOURLY-}
DAILY=${DAILY-7}
WEEKLY=${WEEKLY-5}
MONTHLY=${MONTHLY-12}
YEARLY=${YEARLY-}
UUID=$(head /dev/urandom |tr -dc A-Za-z0-9 |head -c 16)

mkdir -pv "$BACKUP_DIR"
set -x
tar cvzf "$BACKUP_FILE.$UUID.tmp" "$DB_PATH"
set +x
mv -v "$BACKUP_FILE"{.$UUID.tmp,}

PATH=$PATH:/usr/local/bin rotate-backups \
  $([[ -n "$HOURLY" ]] && echo "--hourly=$HOURLY") \
  $([[ -n "$DAILY" ]] && echo "--daily=$DAILY") \
  $([[ -n "$WEEKLY" ]] && echo "--weekly=$WEEKLY") \
  $([[ -n "$MONTHLY" ]] && echo "--monthly=$MONTHLY") \
  $([[ -n "$YEARLY" ]] && echo "--yearly=$YEARLY") \
  --include="${BACKUP_NAME}_*.tar.gz" \
  --prefer-recent --relaxed --verbose --force \
  "$BACKUP_DIR"

