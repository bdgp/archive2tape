#!/usr/bin/env bash
set -eux -o pipefail
dr=${DOCKER_REGISTRY:-fiji:443/bdgp}
img=${DOCKER_IMAGE:-archive2tape}

#(cd .. && nix run github:cargo2nix/cargo2nix)

(cd .. && nix build -o k8s/result)

#./result |docker load && docker push "$dr/$img"
./result |gzip --fast |skopeo --insecure-policy copy --dest-tls-verify=false docker-archive:/dev/stdin docker://"$dr/$img"

k8script.py --su-exec --init-script 'ln -s /proc/self/mounts /etc/mtab; suexec="$(readlink /bin/su-exec)"; rm /bin/su-exec; cp "$suexec" /bin/su-exec; chmod u=s,go=x /bin/su-exec' --node ubx --privileged -v /etc/pam.d -B /dev/fuse -B /dev/tape -B /media -v /run/systemd -v /home/bbooth --hide-nix --env LOCALE_ARCHIVE=/lib/locale/locale-archive --launcher -i "$dr/$img" sh -c ''
